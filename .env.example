# ---------- LLM provider (AutoSetModelByKey reads these) ----------
# OpenAI-compatible base URL, e.g. https://api.openai.com/v1  or  https://openrouter.ai/api/v1
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here
# Leave MODEL empty to let AutoSetModelByKey probe /models and pick the best working one
MODEL=
# Restrict AutoSetModelByKey probing to models whose /models metadata says they
# are free (same as the --free-only CLI flag). Unset = consider every model.
FREE_ONLY=false
# How hard the model reasons before answering: off | low | medium | high | max
# This is a SETTING, not a chat mode. Change it at runtime with /think <level>.
THINKING_LEVEL=max

# ---------- Agent settings (the agent's own autonomous behaviour) ----------
# Distinct from THINKING_LEVEL: these steer J+Rock's agentic loops (code
# review, bug_fix, self-heal, autopsy), not the model's chat reasoning.
# Max steps any agentic loop may take before stopping. 0 = unlimited.
AGENT_MAX_STEPS=128
# How hard the agent reasons on agentic work: off | low | medium | high | max
AGENT_THINKING=max
# Seconds between autonomous iterations.
AGENT_AUTONOMOUS_SEC=15
# Rate-limit window, in seconds, for agent calls.
AGENT_RATE_LIMIT_WINDOW=128

# ---------- Bitunix futures ----------
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/
# Market data source: rest | ws. Default rest - the public WS layer is verified,
# but the private (position/order/balance) login has not been verified against
# the live server. Switch with /ws on once you have confirmed it on your keys.
MARKET_DATA_SOURCE=rest
# Debug helpers. Both are off by default and safe to leave off.
# Log the exact signed preimage, digest and signature at debug level. Never
# prints the secret key itself, but the signature is sensitive - keep it off
# in shared logs.
BITUNIX_DEBUG_SIGN=false
# Log the exact order body sent next to any exchange error (error 10002 etc.).
BITUNIX_DEBUG_ORDER=false

# ---------- Persistence ----------
# NOTE: runtime settings are persisted to data/state.json and take precedence
# over the values below on the next start (store > .env > default). A value you
# change at runtime with an engine command wins over .env; the .env line is
# kept in sync as a convenience mirror only.

# ---------- J+Rock permissions ----------
# auto accept edit: true = apply self-edits automatically (logged), false = show diff and wait.
# With it false, self-heal repairs are QUEUED: review them with `pending`, apply
# one with `/approve`, then run `/selfheal once` to verify and commit it.
AUTO_ACCEPT_EDIT=false
# whole terminal / device access granted by the user
FULL_DEVICE_ACCESS=false
# hard block on destructive shell commands even when FULL_DEVICE_ACCESS=true
BLOCK_DESTRUCTIVE=true

# ---------------------------------------------------------------------------
# The durable state (settings, engine state, positions).
#
# Empty -> the file store: data/state.json, INSIDE the working copy. A
# redeploy that recreates the checkout (fresh clone, container without a
# volume) takes that file with it, and the agent comes back looking like it
# reset everything.
#
# Set -> the database IS the state, so it survives a redeploy.
#   DATABASE_URL=postgresql://user:password@host:5432/jrock
# The agent fails closed when this is set but the database is unreachable:
# a silent fallback to a file would reproduce the bug this setting fixes.
# Needs: pip install 'psycopg[binary]'
DATABASE_URL=

# ---------- Trader defaults ----------
# SYMBOLS=AUTO uses the ranked universe below. TRADE_SYMBOLS remains accepted
# as a backwards-compatible alias.
SYMBOLS=AUTO
TRADE_LEVERAGE=10
TRADE_MARGIN_MODE=ISOLATION
TRADE_POSITION_MODE=ONE_WAY
TRADE_MAX_OPEN_POSITIONS=1
TRADE_RISK_PCT=1.0
TRADE_BREAKEVEN_PCT=15
TRADE_TRAILING_TRIGGER_ROI_PCT=20
# Manual stop distance, % of price. 0 means the agent derives the stop from
# liquidation distance, signal strength and ATR (about 50% ROI from liq).
TRADE_SL_DISTANCE_PCT=0
TRADE_SL_DISTANCE_AUTO=true
TRADE_MIN_AGREEING=2
TRADE_TIMEFRAMES=1m,3m,5m,15m
TRADE_MIN_CONFIDENCE=80
TRADE_TF_MIN_CONFIDENCE=60
TRADE_SCAN_INTERVAL=15
TRADE_REPORT_INTERVAL=30

# ---------- Universe auto-ranking ----------
# Let the scan loop pick symbols instead of scanning the static watchlist.
# UNIVERSE_RANK sets the method: GAINERS | LOSERS | VOLUME | MOVERS ("" = off).
# UNIVERSE_SIZING is how many top-ranked symbols to scan (1..50; 0 = off).
# MIN_24H_VOLUME_USD filters out illiquid pairs by 24h quote volume.
# GAINERS/LOSERS/MOVERS rank by PERCENT change since the 24h open.
# Runtime: `universe rank LOSERS`, `universe sizing 20`, `universe volume 1000000`,
#          `universe rank auto` (keep the method, VOLUME if none), `universe rank off`.
UNIVERSE_RANK=VOLUME
UNIVERSE_SIZING=50
MIN_24H_VOLUME_USD=1000000

# ---------- Order-size bounds (USDT). 0 = disabled ----------
# The engine's OWN limits, checked BEFORE the request is sent. The exchange
# has its own (minTradeVolume / maxMarketOrderVolume) which are enforced too.
MIN_MARGIN_USDT=0
MAX_MARGIN_USDT=0
MAX_NOTIONAL_USDT=0

# ---------- Margin amount per trade ----------
# How much of the SPENDABLE balance one position may lock as MARGIN, in percent.
# This is the size knob: 10 = a single position may lock 10% of the available
# balance as margin, so up to ten positions could be open at once.
#
# It is a MARGIN budget, not a notional budget, because margin is what the
# exchange actually deducts from `available` - so the number set here is the
# number you see leave your balance. The notional it implies is
# `margin * leverage`, minus the taker fee.
#
# It composes with the balance cap by taking the MINIMUM of the two notionals,
# so it can only ever make an order SMALLER; it can never talk the engine into
# an order the balance cannot pay for. 0 disables it and sizes purely by
# TRADE_RISK_PCT, capped by the whole spendable balance.
#
# Runtime: `margin amount 100` (or just say "use 100% of my balance per trade").
# MARGIN_PER_TRADE is the canonical name; MARGIN_AMOUNT_PCT is the legacy alias.
MARGIN_PER_TRADE=100

# The leverage an entry may use is checked against the symbol's OWN tiered
# risk-limit table (get_position_tiers): the tier your leverage maps to is the
# HIGHEST tier whose maximum leverage still covers the selection (the Bitunix
# example: 50x -> tier 3), MMR comes from that tier, and the position value
# must fit that tier's nominal cap or the entry is refused (fail-closed).
# No clamp, no fallback tier, no reduction - if no tier covers the selection
# the entry is refused.

# Which unit the engine sizes an order in, per the official Bitunix help
# article "Explanation of the Order Units in Futures Trading":
#   QUANTITY (default) - base-coin quantity (what place_order's `qty` takes)
#   NOTIONAL           - position value in USDT;  qty = notional / price
#   COST               - margin paid in USDT;     qty = cost * leverage / price
# The wire format is always base-coin `qty`; the unit only changes how the size
# is specified and converted.
ORDER_UNIT=QUANTITY

# Everything else that protects a stop is FIXED in code, on purpose:
#   LAST_PRICE triggers, a 3-tick minimum stop gap, fresh trigger reads before
#   every TP/SL write. One knob, one meaning.

# ---------------------------------------------------------------- TP/SL methods
# Two methods choose the NATIVE exit shape a new position gets. The other two
# documented methods are ALWAYS armed, in the manage loop:
#   TRAILING - stop moves to breakeven at TRADE_BREAKEVEN_PCT ROI, then trails
#              behind price from TRADE_TRAILING_TRIGGER_ROI_PCT ROI (ratchet,
#              only enforced while the engine is running)
#   ACCOUNT  - closes ALL positions when total unrealized PnL crosses
#              ACCOUNT_TP_USDT / ACCOUNT_SL_USDT (same caveat)
#   POSITION           - one TP/SL closes the ENTIRE position
#                        (/tpsl/position/place_order, exchange-enforced)
#   PARTIAL            - scale out in stages; each rung of PARTIAL_TP_LADDER is
#                        its own native /tpsl/place_order with tpQty, parked at
#                        entry, so the exchange enforces every rung even if the
#                        engine is down
TPSL_METHOD=PARTIAL

# PARTIAL ladder, "R:share" pairs (the legacy "share@R" spelling is also
# accepted): close share% of the position once price runs R x the entry-to-stop
# distance. This ladder closes 25% at each of 1R, 2R, 3R and 4R.
# R must increase left to right; shares must sum to <= 100.
# Runtime: "partial ladder 1R:25,2R:25,3R:25,4R:25" / "partial ladder off".
PARTIAL_TP_LADDER=1R:25,2R:25,3R:25,4R:25

# ACCOUNT: close every position when total unrealized PnL reaches these USDT
# thresholds. 0 disables that side. Both 0 = account TP/SL is off.
# Runtime: "account tp usdt 100" / "account sl usdt 50".
ACCOUNT_TP_USDT=0
ACCOUNT_SL_USDT=0

# ---------------------------------------------------------------- Self-repair
# The repair loop: pytest -> LLM review -> apply exact-string fixes -> retest
# -> commit + push to origin main when green. It never touches .env or data/,
# edits at most 5 files per cycle and reverts everything if the tests fail.
# How often the background loop runs, in hours. 0 = loop off (/selfheal still works).
SELF_HEAL_INTERVAL_HOURS=6
# 1 = commit and push a verified repair to origin/main; 0 keeps the loop
# report-only (fixes stay uncommitted and nothing is pushed).
SELF_HEAL_AUTO_PUSH=1

# ---------------------------------------------------------------- Telegram bot
# Chat command surface: positions, open orders, PnL and the engine status,
# delivered in Telegram.
#
# Get a token from @BotFather (Telegram -> @BotFather -> /newbot).
# The token is a full credential - treat it like an API secret and NEVER
# commit a real one. The bot reads only this environment variable.
#
#   export TELEGRAM_BOT_TOKEN=123456789:AA...
#   python -m jrock.telegram_bot
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated chat ids the bot may answer. Empty = any chat that
# finds the bot. Your own chat id is printed to the log on the first message.
TELEGRAM_ALLOWED_CHATS=
