# ---------- LLM provider (AutoSetModelByKey reads these) ----------
# OpenAI-compatible base URL, e.g. https://api.openai.com/v1  or  https://openrouter.ai/api/v1
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here
# Leave MODEL empty to let AutoSetModelByKey probe /models and pick the best working one
MODEL=
# How hard the model reasons before answering: off | low | medium | high | max
# This is a SETTING, not a chat mode. Change it at runtime with /think <level>.
THINKING_LEVEL=medium

# ---------- Bitunix futures ----------
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/
# Market data source: rest | ws. Default rest - the public WS layer is verified,
# but the private (position/order/balance) login has not been verified against
# the live server. Switch with /ws on once you have confirmed it on your keys.
MARKET_DATA_SOURCE=rest
# A cached WS price older than this is never used for a trading decision -
# the engine falls back to REST and logs a warning instead.
PRICE_MAX_AGE_SEC=5
# A candle set is stale when the newest candle's open time is older than
# KLINE_MAX_AGE_SEC * interval. A 1m candle is legitimately 60s old, so the
# price rule (flat seconds) does not apply to candles. 2 = two intervals.
KLINE_MAX_AGE_SEC=2
# Hard cap on candles held per (symbol, interval). Bounded, never unbounded.
KLINE_CACHE_MAX=500
# log the exact order body next to any error (diagnose 10002 in one look)
BITUNIX_DEBUG_ORDER=false

# ---------- Persistence ----------
# Hard cap on retained memory entries. Beyond this the weakest entries are
# evicted (low weight first, then oldest) so the file cannot grow forever.
MAX_MEMORY_ITEMS=5000
# NOTE: runtime settings are persisted to data/state.json and take precedence
# over the values below on the next start (store > .env > default). A value you
# change at runtime with an engine command wins over .env; the .env line is
# kept in sync as a convenience mirror only.

# ---------- Web dashboard (python -m jrock.web) ----------
# Port and interface the browser dashboard listens on. 127.0.0.1 = this machine
# only. Do not bind to 0.0.0.0 without TLS and a reverse proxy in front.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Password for the dashboard. Every request must send it (X-Auth-Token header or
# ?token= in the URL). Leave empty to get a random token printed at each start.
# This is NOT an API key: pick any long random string.
WEB_TOKEN=

# ---------- J+Rock permissions ----------
# auto accept edit: true = apply self-edits automatically (logged), false = show diff and wait
AUTO_ACCEPT_EDIT=false
# whole terminal / device access granted by the user
FULL_DEVICE_ACCESS=false
# hard block on destructive shell commands even when FULL_DEVICE_ACCESS=true
BLOCK_DESTRUCTIVE=true

# ---------- Trader defaults ----------
TRADE_SYMBOLS=BTCUSDT
TRADE_LEVERAGE=10
TRADE_MARGIN_MODE=ISOLATION
TRADE_POSITION_MODE=ONE_WAY
TRADE_MAX_OPEN_POSITIONS=3
TRADE_RISK_PCT=1.0
TRADE_BREAKEVEN_PCT=0.6
TRADE_TRAILING_TRIGGER_ROI_PCT=25
TRADE_LIQ_SL_DISTANCE_PCT=50
TRADE_MIN_AGREEING=3
TRADE_TIMEFRAMES=1m,3m,5m,15m
TRADE_MIN_CONFIDENCE=70
TRADE_TF_MIN_CONFIDENCE=60
TRADE_SCAN_INTERVAL=30
TRADE_REPORT_INTERVAL=30

# ---------- Universe selection (rank, size, 24h volume floor) ----------
# Ported from the JavaScript engine (src/scanner/scanner.js). When the universe
# is ON the engine rebuilds its symbol list from the exchange's full pair list
# on every scan, instead of scanning a fixed list.
#
# OFF by default: an explicit TRADE_SYMBOLS list is honoured verbatim and the
# settings below are inert. Turn it on with either
#   SYMBOLS=AUTO
#   UNIVERSE_AUTO=1
# An explicit TRADE_SYMBOLS list always wins, so the two can never fight over
# the symbol list.
UNIVERSE_AUTO=0
# VOLUME | GAINERS | LOSERS | MOVERS
#   VOLUME  - deepest books first (default, the safe choice)
#   GAINERS - only coins UP on the day, biggest gain first
#   LOSERS  - only coins DOWN on the day, biggest fall first
#   MOVERS  - biggest move either way
# GAINERS/LOSERS FILTER, they do not just sort: a flat or opposite-moving coin
# is dropped even when fewer than UNIVERSE_SIZE qualify.
UNIVERSE_RANK=VOLUME
# How many ranked pairs to keep. A CEILING, not a quota - a change-ranked mode
# returns fewer when fewer qualify and never pads with non-qualifiers.
UNIVERSE_SIZE=40
# Liquidity floor in USDT. Pairs thinner than this are never scanned - a stop
# can be swept on an illiquid book. 0 disables the floor. Applied BEFORE
# ranking, and matters most in the change-ranked modes, where the biggest
# movers are usually the thinnest books.
MIN_24H_VOLUME_USD=20000000

# ---------- Order-size bounds (USDT). 0 = disabled ----------
# The engine's OWN limits, checked BEFORE the request is sent. The exchange
# has its own (minTradeVolume / maxMarketOrderVolume) which are enforced too.
MIN_MARGIN_USDT=0
MAX_MARGIN_USDT=0
MAX_NOTIONAL_USDT=0

# Taker fee rate charged on a MARKET order, as a fraction of notional.
# Bitunix USDT-M futures VIP 0 is 0.0006 (0.06%). The engine reserves this on
# top of the initial margin, because the exchange deducts both from the
# available balance at once - sizing to margin == balance is what produced
# 20003 Insufficient balance.
TAKER_FEE_RATE=0.0006
# Extra headroom reserved when sizing, as a percent of available balance.
# Covers the price move between sizing and the request landing. 0 disables.
MARGIN_SAFETY_PCT=2.0

# ---------- TP/SL placement ----------
# Minimum distance a stop must keep from the mark/entry price, in ticks
# (1 tick = 10^-quotePrecision). Prevents rounding from collapsing a stop onto
# the mark price, which the exchange rejects with 30029/30031.
TP_SL_MIN_STOP_TICKS=3
# Which price the exchange compares a TP/SL trigger against:
#   MARK_PRICE (default) - the exchange mark price
#   LAST_PRICE           - the last traded price
# The SAME value is used for the local pre-flight validation and for the
# tpStopType/slStopType sent in the order body, so the two can never disagree.
# A disagreement is exactly what produced 30029 (stop checked against the last
# price, rejected against the mark price).
TP_SL_TRIGGER_TYPE=MARK_PRICE

# ---------- Order unit ----------
# Which unit the engine sizes an order in, per the official Bitunix help
# article "Explanation of the Order Units in Futures Trading":
#   QUANTITY (default) - base-coin quantity (what place_order's `qty` takes)
#   NOTIONAL           - position value in USDT;  qty = notional / price
#   COST               - margin paid in USDT;     qty = cost * leverage / price
# The wire format is always base-coin `qty`; the unit only changes how the size
# is specified and converted.
ORDER_UNIT=QUANTITY

# ---------- The 4 TP/SL methods ----------
# Which of the four documented Bitunix TP/SL methods the engine uses. These are
# the four from the official academy article "Bitunix Futures Positions: Guide
# to Four TP/SL Methods":
#   POSITION (default) - one TP/SL closes the ENTIRE position.
#                        Native: /tpsl/position/place_order. Exchange-enforced.
#   PARTIAL            - a defined % closes at each trigger, the rest stays open.
#                        Native: /tpsl/place_order with tpQty/slQty.
#                        Exchange-enforced.
#   TRAILING           - dynamic exit: arms after a trend, then trails behind
#                        price. No native endpoint - software, so it only runs
#                        while the manage loop is up.
#   ACCOUNT            - closes ALL positions when TOTAL account PnL crosses a
#                        threshold. No native endpoint - software, same caveat.
TPSL_METHOD=POSITION

# PARTIAL: what fraction to close, and at what ROI to do it.
PARTIAL_CLOSE_PCT=50
PARTIAL_AT_ROI_PCT=50

# ACCOUNT: absolute USDT thresholds and/or % of available equity.
# 0 disables that leg. At least one of the four must be non-zero to arm it.
ACCOUNT_TP_USDT=0
ACCOUNT_SL_USDT=0
ACCOUNT_TP_PCT=0
ACCOUNT_SL_PCT=0

# ---------------------------------------------------------------------------
# TP LADDER - multi-level partial take-profit
# ---------------------------------------------------------------------------
# An ordered list of rungs, each closing a slice of the ORIGINAL position as
# the trade runs in its favour. Empty = disabled, which falls back to the
# single-level PARTIAL method above.
#
#   TP_LADDER=1R:25,2R:25,3R:25   close 25% at 1R, 25% at 2R, 25% at 3R
#   TP_LADDER=50:25,100:25        ROI percent (with the basis set to ROI)
#   TP_LADDER=0.0055:30,0.0060:30 absolute prices (basis PRICE)
#
# close_pct is ALWAYS a share of the ORIGINAL position size, never of the
# remaining size. The values must sum to <= 100; anything more is rejected.
TP_LADDER=

# Which level moves the stop to breakeven. 1 = after the first level fills.
# 0 disables the breakeven move.
TP_LADDER_BREAKEVEN_AFTER=1

# What to do with whatever is left after the last level:
#   trail - hand it to the trailing stop (default)
#   close - close it with the last level
TP_LADDER_RUNNER=trail

# How a level's trigger is read:
#   R     - a multiple of the INITIAL risk (entry-to-stop distance)
#   ROI   - a percent return on margin
#   PRICE - an absolute price
TP_LADDER_TRIGGER_BASIS=R
